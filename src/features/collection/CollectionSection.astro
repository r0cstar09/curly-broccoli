---
import CollectionCard from './CollectionCard.astro';
import { PageHeading, PageSection } from '~/components/ui/PageSection.tsx';
import { getCollections } from 'storefront:client';

export interface Props {
	heading?: string;
}

const collectionsResponse = await getCollections();

const collections = collectionsResponse.data?.items ?? [];

const HEADING_ID = 'collection-section-heading';
const { heading = 'Shop by collection' } = Astro.props;
---

<PageSection aria-labelledby={HEADING_ID}>
	<PageHeading id={HEADING_ID}>{heading}</PageHeading>
	<div class="grid gap-5 sm:grid-cols-[repeat(auto-fit,minmax(17rem,1fr))]">
		{
			collections.map(
				(collection) =>
					collection.slug && <CollectionCard {...collection} slug={collection.slug} />,
			)
		}
	</div>
	<p class="mt-4">
		<a
			href={collections[0]?.slug ? `/collections/${collections[0].slug}` : '/'}
			class="inline-flex rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-sm font-semibold uppercase tracking-[0.12em] text-theme-accent-200 transition duration-300 hover:-translate-y-0.5 hover:border-theme-accent-400/50 hover:bg-theme-accent-500/10 hover:text-white"
		>
			View all products
		</a>
	</p>
</PageSection>
