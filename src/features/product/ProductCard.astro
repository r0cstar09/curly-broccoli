---
import type { Product } from 'storefront:client';
import { twMerge } from 'tailwind-merge';
import Card from '~/components/ui/Card.tsx';
import { formatProductPrice } from '~/lib/currency.ts';
import { productPath } from '~/paths.ts';
import { ProductPrice } from './ProductPrice.tsx';

interface Props extends Product {
	class?: string;
	elementId?: string | null;
	imageLoading?: 'eager' | 'lazy';
}

const { class: className, elementId, imageLoading, ...product } = Astro.props;
const imageSrc = product.imageUrl.startsWith('/')
	? product.imageUrl
	: new URL(product.imageUrl, Astro.url).href;
---

<a
	href={productPath(product.slug)}
	class={twMerge(
		`group relative block w-full focus-visible:ring-0 transition-all duration-500 ease-out`,
		`hover:-translate-y-2`,
		className,
	)}
	id={elementId ?? undefined}
	aria-label={`${product.name} for ${formatProductPrice(product.price)}`}
>
	<article class="relative">
		{
			(product.discount > 0 || product.collectionIds?.includes('bestSellers')) && (
				<span class="absolute left-3 top-3 z-10 rounded-full border border-white/20 bg-theme-accent-500/90 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-white shadow-lg backdrop-blur">
					New
				</span>
			)
		}
		<Card
			class="flex aspect-[5/6] items-center justify-center overflow-hidden rounded-[1.35rem] bg-gradient-to-br from-white/[0.08] via-theme-base-900 to-theme-accent-950/70 p-2 shadow-astro-card transition-all duration-500 ease-out group-hover:shadow-astro-lift group-hover:ring-2 group-hover:ring-theme-accent-400/40"
		>
			<div
				class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_30%_0%,rgb(255_255_255_/_0.18),transparent_32%)] opacity-70"
			>
			</div>
			<img
				src={imageSrc}
				alt={product.name}
				width={290}
				height={348}
				loading={imageLoading ?? 'lazy'}
				class="relative z-10 size-full rounded-[1rem] object-cover transition-transform duration-700 ease-out group-hover:scale-110"
				draggable="false"
			/>
		</Card>
		<div class="flex flex-col gap-2 px-2 py-3 font-medium transition-colors duration-300">
			<h3
				class="text-pretty leading-tight text-theme-base-100 transition-colors duration-300 group-hover:text-theme-accent-200"
			>
				{product.name}
			</h3>
			<p class="text-lg/tight text-theme-base-300">
				<ProductPrice price={product.price} discount={product.discount} />
			</p>
		</div>
	</article>
	<div
		class="pointer-events-none absolute inset-0 ring-inset ring-theme-accent-600 group-focus-visible:ring-2"
	>
	</div>
</a>
